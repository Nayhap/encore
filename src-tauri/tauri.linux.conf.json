{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Encore",
        "width": 1360,
        "height": 860,
        "minWidth": 880,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#0e1014",
        "create": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "appimage"
    ],
    "linux": {
      "deb": {
        "depends": [
          "python3-venv (>= 3.11) | python3.11-venv",
          "libasound2t64 | libasound2",
          "libdbus-1-3"
        ],
        "recommends": [
          "nodejs"
        ]
      }
    }
  }
}
