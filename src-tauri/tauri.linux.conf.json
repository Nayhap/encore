{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "Encore",
        "width": 1360,
        "height": 860,
        "minWidth": 880,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#0e1014",
        "create": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2",
          "libdbus-1-3"
        ]
      },
      "rpm": {
        "depends": [
          "libasound.so.2()(64bit)",
          "libdbus-1.so.3()(64bit)",
          "libc.so.6(GLIBC_2.35)(64bit)"
        ]
      }
    }
  }
}
